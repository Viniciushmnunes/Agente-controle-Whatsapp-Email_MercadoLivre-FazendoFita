# CRM_ADMIN_PASSWORD=  # At least 20 random characters
# BLING_STORE_ID=  # Numeric API store ID, not its display name or suffix 01
# BLING_START_DATE=2026-10-01
# BLING_VALID_STATUS_IDS=  # Confirm statuses before classifying recurrence
# BLING_EXCLUDED_STATUS_IDS=
# BLING_PENDING_STATUS_IDS=
